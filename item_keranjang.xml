<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:background="@color/white">

    <View android:layout_width="56dp" android:layout_height="56dp"
        android:background="#F0F0F0" android:layout_marginEnd="12dp"/>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tvNamaKeranjang"
            android:textSize="13sp" android:textColor="@color/text_primary" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvKategoriKeranjang"
            android:textSize="11sp" android:textColor="@color/text_secondary"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/tvHargaKeranjang"
            android:textSize="13sp" android:textColor="@color/text_primary" android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>

    <TextView android:id="@+id/btnHapusKeranjang"
        android:text="✕" android:textSize="16sp" android:textColor="@color/text_secondary"
        android:padding="8dp"
        android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
