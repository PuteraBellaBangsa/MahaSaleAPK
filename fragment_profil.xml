<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:text="Profile"
            android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:padding="16dp" android:background="@color/white"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <!-- Info akun -->
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <View android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_avatar"
                android:layout_marginEnd="12dp"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvNamaProfil"
                    android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Lihat profil"
                    android:textSize="12sp" android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <TextView android:text="›" android:textSize="18sp" android:textColor="@color/text_secondary"
                android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Banner jual -->
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#222222"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:text="Mulai jual barangmu"
                    android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Barang tidak terpakai bisa jadi cuan"
                    android:textColor="#AAAAAA" android:textSize="11sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <Button android:id="@+id/btnJualDariProfil"
                    android:text="Jual" android:textSize="12sp"
                    android:layout_width="60dp" android:layout_height="32dp"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="@color/black" android:textColor="@color/white"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Menu grup 1 -->
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:layout_marginBottom="8dp">

            <LinearLayout android:id="@+id/menuFavorit"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground">
                <TextView android:text="🤍" android:textSize="18sp" android:layout_marginEnd="12dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Favorit" android:textSize="13sp" android:textColor="@color/text_primary"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                <TextView android:text="›" android:textSize="16sp" android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/border_color"/>

            <LinearLayout android:id="@+id/menuWallet"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground">
                <TextView android:text="👛" android:textSize="18sp" android:layout_marginEnd="12dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Wallet" android:textSize="13sp" android:textColor="@color/text_primary"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                <TextView android:text="Rp 0  ›" android:textSize="12sp" android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/border_color"/>

            <LinearLayout android:id="@+id/menuPesanan"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground">
                <TextView android:text="📦" android:textSize="18sp" android:layout_marginEnd="12dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Pesanan" android:textSize="13sp" android:textColor="@color/text_primary"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                <TextView android:text="›" android:textSize="16sp" android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Menu grup 2 -->
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp"
            android:layout_marginBottom="8dp">

            <LinearLayout android:id="@+id/menuSettings"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground">
                <TextView android:text="⚙️" android:textSize="18sp" android:layout_marginEnd="12dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Settings" android:textSize="13sp" android:textColor="@color/text_primary"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                <TextView android:text="›" android:textSize="16sp" android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/border_color"/>

            <LinearLayout android:id="@+id/menuContact"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground">
                <TextView android:text="💬" android:textSize="18sp" android:layout_marginEnd="12dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Contact support" android:textSize="13sp" android:textColor="@color/text_primary"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
                <TextView android:text="›" android:textSize="16sp" android:textColor="@color/text_secondary"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="@color/border_color"/>

            <LinearLayout android:id="@+id/menuLogout"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground">
                <TextView android:text="🚪" android:textSize="18sp" android:layout_marginEnd="12dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Logout" android:textSize="13sp" android:textColor="#E24B4A"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
